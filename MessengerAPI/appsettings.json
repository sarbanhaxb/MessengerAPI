{
  "DatabaseSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "messenger",
    "UsersCollectionName": "users",
    "MessagesCollectionName": "messages",
    "ChatsCollectionName": "chats"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyForJWT_ChangeThisInProduction_MinimumLength32Characters!",
    "Issuer": "MessengerAPI",
    "Audience": "MessengerClient",
    "ExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
